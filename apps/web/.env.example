# =============================================================================
# CarryAm Environment Variables
# Copy to .env.local and fill in your values
# =============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# SMS OTP Provider (Termii)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=CarryAm

# KYC Provider (Prembly / Smile ID)
PREMBLY_API_KEY=your-prembly-api-key
PREMBLY_APP_ID=your-prembly-app-id

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
